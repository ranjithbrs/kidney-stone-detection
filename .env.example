# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to '.env' and populate with your local secure configuration.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# Flask Web Application Configuration
# Generate a secure 32-byte secret key with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secure_flask_secret_key_here
FLASK_DEBUG=False
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=1kidneystoneyolodb

# Admin Portal Credentials
# Recommended: Set a dedicated administrative username and generate a secure password hash.
# Generate hash with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# SMTP / Email Notification Configuration (Optional)
# If left empty, automated email alerting is safely disabled without runtime failure.
# Generate a 16-character App Password in Google Account Settings (never commit it).
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=example@gmail.com
SMTP_PASSWORD=
MAIL_SENDER=example@gmail.com

# ---------------------------------------------------------------------------
# Cloud Full-Stack Backend (FastAPI + Supabase PostgreSQL + React Frontend)
# ---------------------------------------------------------------------------
# Pooled or direct Postgres connection string from Supabase / Railway
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=
SUPABASE_DB_URL=

# Random 32+ byte secret for signing stateless Bearer auth tokens (set in Railway Env Vars)
NEFROAI_JWT_SECRET=
NEFROAI_TOKEN_TTL_SECONDS=86400

# Comma-separated browser origins permitted for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8000
PORT=8000
